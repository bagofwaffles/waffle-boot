{
 "tokens": {
  "title": {"rows": 1, "groups": [["waffle-boot"], ["$version", "v$version"]]},
  "option-item:on": {"rows": 1, "groups": [["2"], ["session", "protected"], ["on"]], "not": ["off"]},
  "option-item:off": {"rows": 1, "groups": [["2"], ["session", "protected"], ["off"]], "not": ["on"]},
  "option prompt": {"rows": 9, "groups": [["slot*", "bootloader*"], ["first stage", "first-stage", "spiboot"], ["no", "never", "not"], ["stock"], ["factory", "metadata", "serial*"], ["reset"], ["hold*"], ["5 s", "5 seconds", "five seconds"]]},
  "indicator": {"rows": 1, "groups": [["protected", "option"], ["on"]], "not": ["off"]},
  "slave:no_os": {"rows": 1, "groups": [["slave", "second processor", "dsp2"], ["os"]], "not": ["absent"]},
  "slave:absent": {"rows": 1, "groups": [["slave", "second processor", "dsp2"], ["absent", "missing"]]},
  "slave:no_start": {"rows": 1, "groups": [["slave", "second processor", "dsp2"], ["start*"]], "not": ["absent"]},
  "chord:recovery": {"rows": 2, "groups": [["recovery"]], "not": ["bad"]},
  "skipped": {"rows": 1, "groups": [["$label"], ["skipped"], ["option", "protected"]]},
  "skipped:unselected": {"rows": 1, "groups": [["$label"], ["skipped"], ["not selected", "unselected", "left out"]], "not": ["option", "protected"]},
  "skipped:off": {"rows": 1, "groups": [["$label"], ["skipped"], ["not in this version", "not in this build", "switched off", "turned off"]], "not": ["option", "protected", "select*", "unselect*"]},
  "skipped:written": {"rows": 1, "groups": [["$label"], ["skipped"], ["written", "already written"], ["restart*", "reset", "next start"]], "not": ["option", "protected", "select*", "unselect*", "not in this version"]},
  "not updated": {"rows": 2, "groups": [["not updated", "not installed"], ["$label"]]},
  "select:install": {"rows": 9, "groups": [["install*"], ["1"], ["hold*"], ["5 s", "5 seconds", "five seconds"], ["8"], ["cancel*"]], "not": ["first stage", "first-stage", "spiboot"]},
  "select:bootloader": {"rows": 1, "groups": [["slot $next", "other slot"], ["replace*"], ["recovery"]]},
  "sig:mismatch": {"rows": 2, "groups": [["signature"], ["not match", "does not match", "mismatch*", "not valid", "invalid"]], "not": ["valid signature"]},
  "sig:valid": {"rows": 1, "groups": [["signed", "signature"], ["te", "teenage engineering"]], "not": ["not", "invalid", "mismatch*", "unsigned"]},
  "step failed": {"rows": 1, "groups": [["$label"], ["fail*"]]},
  "interrupted": {"rows": 2, "groups": [["install*"], ["finish*", "complete*", "interrupted"], ["again"]]},
  "reason line": {"rows": 1, "groups": [["$reason"]]},
  "reset needed": {"rows": 1, "follows": "Operation 10 failed", "groups": [["reset"], ["need*", "required", "must"], ["bootloader", "writ*"]]},
  "recovery:check": {"rows": 1, "groups": [["image"], ["check*"], ["fail*"]]},
  "recovery:count": {"rows": 1, "groups": [["three", "3"], ["start*"], ["finish*", "unfinished"]], "not": ["check*"]},
  "recovery:slot:good": {"rows": 1, "groups": [["slot $slot"], ["checked"]], "not": ["check failed", "tried"]},
  "recovery:slot:bad": {"rows": 1, "groups": [["slot $slot"], ["check failed"]], "not": ["checked"]},
  "recovery:version": {"rows": 1, "groups": [["slot $slot"], ["$version", "v$version"]]},
  "recovery:running": {"rows": 1, "groups": [["slot $slot"], ["running", "runs"]], "not": ["not the running"]},
  "recovery:selected": {"rows": 1, "groups": [["slot $slot"], ["boot slot"]], "not": ["not yet the boot slot", "not the boot slot", "becomes the boot slot", "will be the boot slot", "make"]},
  "recovery:target": {"rows": 1, "groups": [["slot $next"], ["writ*"]], "not": ["no write", "refus*", "cannot write", "not written", "written", "fail*", "damaged"]},
  "recovery:refused:not_running": {"rows": 1, "groups": [["no write", "refus*", "cannot write", "not written"], ["running"], ["not known", "unknown", "not established", "not confirmed", "cannot tell"]]},
  "recovery:refused:unverified": {"rows": 1, "groups": [["no write", "refus*", "cannot write", "not written"], ["restart*", "reset"]], "not": ["running", "bad", "fail*"]},
  "recovery:refused:selected_bad": {"rows": 1, "groups": [["no write", "refus*", "cannot write", "not written"], ["boot slot"], ["fail*", "check*"], ["change*", "first"]], "not": ["running", "restart*"]},
  "recovery:writing": {"rows": 2, "groups": [["writing"], ["slot $slot"], ["power"]], "not": ["no write", "refus*", "cannot write", "not written"]},
  "recovery:in_place": {"rows": 1, "groups": [["cut", "power-off", "power off"], ["no image", "nothing", "no slot"], ["start*", "boot*"]]},
  "recovery:done": {"rows": 2, "groups": [["slot $next"], ["written"], ["restart*"]], "not": ["fail*"]},
  "recovery:failed": {"rows": 2, "groups": [["fail*"], ["as before", "as it did before", "unchanged", "nothing was selected", "not selected"]]},
  "recovery:failed:selector": {"rows": 2, "groups": [["fail*"], ["selector"], ["both slots", "no slot", "restart boots", "no checked slot"]], "not": ["as before"]},
  "recovery:held": {"rows": 1, "groups": [["power"], ["keep", "stay*", "leave"], ["until"], ["writ*"], ["finish*", "ended", "done", "complete*"]], "not": ["cut"]},
  "recovery:unsettled": {"rows": 1, "groups": [["slot $slot"], ["written"], ["not yet the boot slot", "not the boot slot"], ["again"]], "not": ["damaged"]},
  "recovery:damaged:rewrite": {"rows": 1, "groups": [["slot $slot"], ["damaged", "bad"], ["writ*"], ["again"], ["power*"]], "not": ["restart*", "other slot"]},
  "recovery:damaged:other": {"rows": 1, "groups": [["slot $slot"], ["damaged", "bad"], ["restart*", "reset"], ["other slot"]], "not": ["again"]},
  "recovery:trial": {"rows": 2, "groups": [["another front", "other front", "new front"], ["tried", "trial"], ["off and on", "power cycle", "switch* off"], ["slot $slot"], ["boot*"]], "not": ["fail*", "no write"]},
  "recovery:trial:written": {"rows": 1, "groups": [["slot $next"], ["written"], ["trial"]], "not": ["fail*", "no write", "boot slot"]},
  "recovery:trial:start": {"rows": 1, "groups": [["trial start"], ["slot $slot"], ["host"], ["keep*"]], "not": ["fail*", "no write", "written"]},
  "recovery:select": {"rows": 1, "groups": [["slot $next"], ["tried", "trial"], ["being selected", "selecting"]], "not": ["fail*", "no write", "host"]},
  "recovery:slot:tried": {"rows": 1, "groups": [["slot $slot"], ["tried"]], "not": ["started", "checked"]},
  "recovery:slot:started": {"rows": 1, "groups": [["slot $slot"], ["tried"], ["started"]], "not": ["not started"]},
  "recovery:foreign": {"rows": 1, "groups": [["slot $slot"], ["te", "??"]], "not": ["wb"]},
  "recovery:computer": {"rows": 1, "groups": [["computer"], ["writ*", "image"]]},
  "recovery:menu": {"rows": 1, "groups": [["1"], ["boot slot"], ["change"]], "not": ["back", "no write"]},
  "recovery:status": {"rows": 1, "groups": [["v$version", "$version"], ["f$front"]]},
  "recovery:back": {"rows": 1, "groups": [["8"], ["back"]], "not": ["put"]},
  "recovery:action:try": {"rows": 1, "groups": [["1"], ["try"], ["slot $next"]]},
  "recovery:action:switch": {"rows": 1, "groups": [["2"], ["make"], ["slot $next"], ["boot slot"]]},
  "recovery:action:keep": {"rows": 1, "groups": [["3"], ["keep"], ["slot $slot"]]},
  "recovery:action:put_back": {"rows": 1, "groups": [["4"], ["put"], ["back"], ["slot $next"]]},
  "recovery:will:try": {"rows": 1, "groups": [["slot $next"], ["once"], ["trial", "try"]], "not": ["done", "fail*"]},
  "recovery:will:switch": {"rows": 1, "groups": [["slot $next"], ["will be the boot slot", "from now on", "every start"]], "not": ["done", "fail*", "once"]},
  "recovery:will:keep": {"rows": 1, "groups": [["slot $slot"], ["kept", "keep"]], "not": ["done", "fail*"]},
  "recovery:will:put_back": {"rows": 1, "groups": [["slot $next"], ["record"], ["back"]], "not": ["done", "fail*"]},
  "recovery:confirm": {"rows": 1, "groups": [["hold", "held"], ["1"], ["5 s", "5 seconds"], ["confirm*"]]},
  "recovery:tier:front": {"rows": 1, "groups": [["another front", "other front"], ["recovery"]], "not": ["waffle-boot"]},
  "recovery:tier:foreign": {"rows": 1, "groups": [["not a waffle-boot", "no waffle-boot", "not waffle-boot"], ["recovery"]]},
  "recovery:tier:bad": {"rows": 1, "groups": [["its check failed"]], "not": ["no write"]},
  "recovery:countdown": {"rows": 1, "groups": [["switch*", "power"], ["off"], ["stop*"], ["$seconds"]], "not": ["no write"]},
  "recovery:act_done": {"rows": 1, "groups": [["done"], ["slot $slot"]], "not": ["fail*"]},
  "continue:restarting": {"rows": 1, "groups": [["restart*", "reboot*"], ["os"]], "not": ["please restart", "restart your", "restart the device", "can't", "cannot", "could not", "unable", "fail*"]},
  "stock": {"rows": 1, "groups": [["waffle-boot"], ["stock"]]},
  "transfer not started": {"rows": 1, "groups": [["transfer"], ["start*", "begin*"], ["not", "cannot", "could not", "failed", "unable"]], "not": ["valid", "reason", "space"]}
 },
