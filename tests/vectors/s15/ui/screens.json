 "start": {"_doc": "S-15.163: a failed plain start. `start` is struct s15_start (why and check by their enum names, cmd and at as S-09 numbers them); `slave` is Device Info's DSP2 state at held mode's start (enum s15_slave), `lost` also says the slave has stopped answering since. `main` is the notice's second line on the main screen, under error:The OS could not be started.; `info` is Device Info's OS start value (at most 42 characters) and `dsp2` its DSP2 value. The first case is the one main_start_lost and info_start_lost show. `first` is the notice's first line; a case with `file` set, a file start's (S-15.195), has its own.", "first": "error:The OS could not be started.", "cases": [
  {"name": "image_read_lost", "start": {"why": "IMAGE_READ", "part": 1, "value": 1281, "limit": 128, "lost": true, "cmd": 18, "at": 4}, "slave": "OK", "main": "dim:   Reason: DSP2 stopped answering during the image read", "info": "Sector 1281 read: 0x12 reply broke", "dsp2": "Not answering"},
  {"name": "no_active", "start": {"why": "NO_ACTIVE"}, "slave": "OK", "main": "dim:   Reason: no active boot partition", "info": "No active boot partition", "dsp2": "OK"},
  {"name": "select", "start": {"why": "SELECT", "part": 2}, "slave": "OK", "main": "dim:   Reason: boot partition 2 select failed", "info": "Partition 2 select failed", "dsp2": "OK"},
  {"name": "select_lost", "start": {"why": "SELECT", "part": 1, "lost": true, "cmd": 24, "at": 7}, "slave": "OK", "main": "dim:   Reason: DSP2 stopped answering at the select", "info": "Select of partition 1: 0x18 timed out", "dsp2": "Not answering"},
  {"name": "header_read", "start": {"why": "HEADER_READ", "part": 1}, "slave": "OK", "main": "dim:   Reason: partition 1 header read failed", "info": "Partition 1 header read failed", "dsp2": "OK"},
  {"name": "header_read_lost", "start": {"why": "HEADER_READ", "part": 2, "lost": true, "cmd": 17, "at": 3}, "slave": "OK", "main": "dim:   Reason: DSP2 stopped answering at the header read", "info": "Header of partition 2: 0x11 no reply", "dsp2": "Not answering"},
  {"name": "image_read", "start": {"why": "IMAGE_READ", "part": 2, "value": 16257, "limit": 128}, "slave": "OK", "main": "dim:   Reason: image read failed", "info": "Partition 2 sector 16257 read failed", "dsp2": "OK"},
  {"name": "image_read_lost_poll", "start": {"why": "IMAGE_READ", "part": 1, "value": 16257, "limit": 128, "lost": true, "cmd": 18, "at": 136}, "slave": "OK", "main": "dim:   Reason: DSP2 stopped answering during the image read", "info": "Sector 16257 read: 0x12 slave fell", "dsp2": "Not answering"},
  {"name": "user_select", "start": {"why": "USER_SELECT"}, "slave": "OK", "main": "dim:   Reason: user area select failed", "info": "User area select failed", "dsp2": "OK"},
  {"name": "user_select_lost", "start": {"why": "USER_SELECT", "lost": true, "cmd": 24, "at": 1}, "slave": "OK", "main": "dim:   Reason: DSP2 stopped answering at the last select", "info": "User area select: 0x18 send failed", "dsp2": "Not answering"},
  {"name": "format", "start": {"why": "FORMAT", "value": 4294967295}, "slave": "OK", "main": "dim:   Reason: header format 4294967295 not supported", "info": "Header format 4294967295 not supported", "dsp2": "OK"},
  {"name": "zero_length", "start": {"why": "ZERO_LENGTH"}, "slave": "OK", "main": "dim:   Reason: image length 0", "info": "Header length 0", "dsp2": "OK"},
  {"name": "too_long", "start": {"why": "TOO_LONG", "value": 4294967295, "limit": 8388608}, "slave": "OK", "main": "dim:   Reason: image over 8 MiB", "info": "Length 4294967295, at most 8388608", "dsp2": "OK"},
  {"name": "past_partition", "start": {"why": "PAST_PARTITION", "value": 1453, "limit": 1024}, "slave": "OK", "main": "dim:   Reason: image runs past its partition", "info": "Needs 1453 sectors, has 1024", "dsp2": "OK"},
  {"name": "crc", "start": {"why": "CRC", "value": 305441741, "limit": 3735928559}, "slave": "OK", "main": "dim:   Reason: image CRC mismatch", "info": "CRC 1234abcd, header says deadbeef", "dsp2": "OK"},
  {"name": "encrypted", "start": {"why": "ENCRYPTED", "part": 1}, "slave": "OK", "main": "error:OS needs reinstalling: install a TE firmware update", "info": "Partition 1 image is encrypted", "dsp2": "OK"},
  {"name": "refused_length", "start": {"why": "REFUSED", "check": "LENGTH"}, "slave": "OK", "main": "dim:   Reason: image too long to stage", "info": "Hand-over check: too long", "dsp2": "OK"},
  {"name": "refused_parse", "start": {"why": "REFUSED", "check": "PARSE"}, "slave": "OK", "main": "dim:   Reason: bad block headers", "info": "Hand-over check: block headers", "dsp2": "OK"},
  {"name": "refused_flags", "start": {"why": "REFUSED", "check": "FLAGS"}, "slave": "OK", "main": "dim:   Reason: block flag not allowed", "info": "Hand-over check: block flags", "dsp2": "OK"},
  {"name": "refused_space", "start": {"why": "REFUSED", "check": "SPACE"}, "slave": "OK", "main": "dim:   Reason: loads outside memory", "info": "Hand-over check: outside memory", "dsp2": "OK"},
  {"name": "refused_staging", "start": {"why": "REFUSED", "check": "STAGING"}, "slave": "OK", "main": "dim:   Reason: loads over the staging area", "info": "Hand-over check: over staging", "dsp2": "OK"},
  {"name": "refused_reserve", "start": {"why": "REFUSED", "check": "RESERVE"}, "slave": "OK", "main": "dim:   Reason: loads over the hand-over reserve", "info": "Hand-over check: over reserve", "dsp2": "OK"},
  {"name": "refused_record", "start": {"why": "REFUSED", "check": "RECORD"}, "slave": "OK", "main": "dim:   Reason: loads over the reboot record", "info": "Hand-over check: over reboot record", "dsp2": "OK"},
  {"name": "refused_boot_reserve", "start": {"why": "REFUSED", "check": "BOOT_RESERVE"}, "slave": "OK", "main": "dim:   Reason: loads over the ROM's boot reserve", "info": "Hand-over check: over boot reserve", "dsp2": "OK"},
  {"name": "slave_no_os", "start": {"why": "SLAVE_NO_OS", "value": 1}, "slave": "NO_OS", "main": "dim:   Reason: DSP2 could not load the OS", "info": "DSP2 answered no OS, reply 1", "dsp2": "No OS"},
  {"name": "no_reply", "start": {"why": "NO_REPLY"}, "slave": "LOST", "main": "dim:   Reason: DSP2 did not answer the release", "info": "No reply to the release", "dsp2": "Not answering"},
