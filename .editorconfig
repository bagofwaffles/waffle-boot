# The tree's own conventions; vendored code under src/third_party/ keeps upstream's.
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.c,*.h,*.S,*.ld,*.mk,Makefile,*.sh}]
indent_style = tab
tab_width = 8

[*.py]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[src/third_party/**]
indent_style = unset
indent_size = unset
tab_width = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
